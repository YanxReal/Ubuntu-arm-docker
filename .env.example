# Ubuntu Desktop (GNOME 50) en contenedor — arm64
UBUNTU_VERSION=26.04
PLATFORM=linux/arm64

# Usuario (contraseña = nombre de usuario)
USERNAME=admin
USER_UID=1000
USER_GID=1000

# Escritorio
RESOLUTION=1920x1080
TZ=UTC
LANG=es_ES.UTF-8

# Acceso remoto (VNC y noVNC comparten contraseña)
VNC_PASSWORD=admin
# Puertos en el host (el 5900 del host suele estar ocupado por Screen Sharing de macOS)
VNC_HOST_PORT=5902
NOVNC_HOST_PORT=6080

# SSH (usuario admin / contraseña admin)
SSH_HOST_PORT=2222

# Node.js
NODE_MAJOR=24
