# Normalización de finales de línea — clave para que los scripts funcionen
# igual en Windows, Linux y macOS. Evita los bugs de CRLF (que rompen los
# shells bash) al clonar o editar el repo desde Windows.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
install.sh text eol=lf
scripts/dev text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.c text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
LICENSE text eol=lf
.env text eol=lf
.env.example text eol=lf