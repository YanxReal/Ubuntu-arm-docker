#!/usr/bin/env python3
"""
Wrapper para gnome-remote-desktop-daemon.

Mantiene fd 0 como una socketpair cuyo peer permanece abierto. Así se evita:
- el EBADF por reuso de fd 0 ("Error accepting connection: Bad file descriptor",
  conexiones VNC/noVNC que se caen o fallan al aceptar), y
- el bucle idle de un pipe con POLLHUP (que encerraba GRD a ~95% CPU).

Resultado con headless: GRD a ~0.5% en reposo y conexiones VNC/noVNC estables,
incluyendo cambios de tamaño (resize).
"""
import os
import socket
import sys

r, w = socket.socketpair()
os.dup2(r.fileno(), 0)          # fd 0 = socketpair read (válido, no reutilizable)
os.set_blocking(0, True)
os.set_inheritable(0, True)     # fd 0 sobrevive al exec
os.set_inheritable(w.fileno(), True)  # peer vivo en un fd alto -> sin POLLHUP

os.execv("/usr/libexec/gnome-remote-desktop-daemon",
         ["gnome-remote-desktop-daemon"] + sys.argv[1:])