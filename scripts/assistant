#!/usr/bin/env bash
#
# assistant — capa de control del escritorio para agentes/IA
# ============================================================
# Da a un agente (humano o IA) "vista" y control sobre el escritorio
# Cinnamon (X11). El contenedor sirve el desktop por x11vnc (multi-cliente),
# así que puedes seguir mirando por noVNC/VNC mientras la IA captura y actúa.
#
# Lo que funciona de forma ROBUSTA aquí:
#   - shot / region / ocr : captura real por X11 (import/scrot) + OCR (tesseract)
#   - move / click / type : input real por xdotool (X11)
#   - windows / winmove   : listar y mover ventanas de forma fiable
#   - open / run          : lanza apps o comandos en la sesión gráfica (dev)
#   - status              : estado de la sesión y herramientas
#   - wd                  : pruebas de apps GTK aisladas vía WayDriver
#
# El input GUI (type/click/move) es REAL aquí, gracias a X11 + xdotool.
#
# Subcomandos:
#   assistant status                 -> estado de la sesión y herramientas
#   assistant shot [out.png]         -> captura pantalla completa (X11 real)
#   assistant region X Y W H [out]   -> captura una región
#   assistant ocr [png]              -> OCR de una captura (tesseract)
#   assistant open <app>             -> lanza un app en la sesión (dev)
#   assistant run <cmd...>           -> ejecuta un comando en la sesión
#   assistant wd run --app <cmd>...  -> control headless de apps GTK (WayDriver):
#                                       captura PNG real + click/type/read por
#                                       AT-SPI en una sesión Mutter aislada
#   assistant type "texto"           -> escribe texto (xdotool, X11 real)
#   assistant key ctrl+c|super...    -> atajo de teclado (xdotool)
#   assistant click X Y / move X Y   -> puntero (X11 real)
#   assistant drag DX DY             -> arrastre del puntero (selección)
#   assistant windows                -> lista ventanas (activa * )
#   assistant winmove X Y [wid]      -> MUEVE una ventana (fiable; usa el WM)
#   assistant record [secs] [out]    -> graba VÍDEO del escritorio (ffmpeg/x11grab)
#   assistant files [subdir]         -> listar archivos de /workspace (compartido con host)
#   assistant here <path> [nombre]   -> copia un archivo a /workspace/ai para el host
#
# Transferencia por SSH (siempre disponible):
#   scp -P 2222 local.txt admin@localhost:/workspace/
#   scp -P 2222 admin@localhost:/workspace/ai/screen.png .
#
set -euo pipefail

ENV_FILE="/run/user/$(id -u)/desktop-env"
# Directorio compartido con el HOST (bind mount): la IA/tú veis los archivos al momento
SHOT_DIR="/workspace/ai"
mkdir -p "${SHOT_DIR}" 2>/dev/null || true
export SHOT_DIR

if [ -r "${ENV_FILE}" ]; then
  set -a
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
  set +a
fi

die() { echo "✗ $*" >&2; exit 1; }

cmd_help() { sed -n '2,40p' "$0"; exit 0; }

xneed() { command -v "$1" >/dev/null 2>&1 || { echo "falta $1" >&2; return 1; }; }
have_x() { [ -n "${DISPLAY:-}" ] && [ -e "/tmp/.X11-unix/X${DISPLAY#:}" ]; }

# ── status ─────────────────────────────────────────────────────────────────
cmd_status() {
  echo "Fecha:  $(date)"
  echo "User:   $(id -un) (uid $(id -u))"
  echo "DISPLAY:$([ -n "${DISPLAY:-}" ] && echo " ${DISPLAY}" || echo " (sin sesión X)")"
  have_x && echo "Sesión X: OK" || echo "Sesión X: NO (¿Xvfb/Cinnamon levantado?)"
  echo "captura: $([ -x "$(command -v import 2>/dev/null)" ] || [ -x "$(command -v scrot 2>/dev/null)" ] && echo 'X11 (import/scrot) OK' || echo 'falta import/scrot')"
  echo "input:   $([ -x "$(command -v xdotool 2>/dev/null)" ] && echo 'xdotool OK (X11)' || echo 'falta xdotool')"
  echo "ocr:     $(command -v tesseract >/dev/null && echo OK || echo ausente)"
  echo "waydriver: $([ -x /usr/local/cargo/bin/waydriver-mcp ] && echo OK || echo ausente)"
}

# ── shot / region / ocr (captura real por X11) ─────────────────────────────
cmd_shot() {
  have_x || die "sin sesión X (DISPLAY ${DISPLAY:-})."
  local out="${1:-${SHOT_DIR}/screen.png}"
  mkdir -p "$(dirname "$out")"
  if command -v import >/dev/null 2>&1; then
    import -display "${DISPLAY}" -window root "${out}" >/dev/null 2>&1
  elif command -v scrot >/dev/null 2>&1; then
    scrot -o "${out}" >/dev/null 2>&1
  else
    die "ni import ni scrot."
  fi
  [ -s "$out" ] || die "Captura vacía (¿X levantado?)."
  echo "ok $out"
}

cmd_region() {
  have_x || die "sin sesión X."
  xneed import || die "falta import (imagemagick)."
  local x="${1:?Uso: assistant region X Y W H [out.png]}"
  local y="${2:?Uso: assistant region X Y W H [out.png]}"
  local w="${3:?Uso: assistant region X Y W H [out.png]}"
  local h="${4:?Uso: assistant region X Y W H [out.png]}"
  local out="${5:-${SHOT_DIR}/region.png}"
  mkdir -p "$(dirname "$out")"
  import -display "${DISPLAY}" -window root -crop "${w}x${h}+${x}+${y}" +repage "${out}" >/dev/null 2>&1
  [ -s "$out" ] || die "Región vacía."
  echo "ok $out"
}

cmd_ocr() {
  command -v tesseract >/dev/null 2>&1 || die "tesseract no está instalado."
  local png="${1:-${SHOT_DIR}/screen.png}"
  [ -f "$png" ] || die "No existe la captura: $png"
  tesseract "$png" stdout -l "${OCRLANG:-spa+eng}" 2>/dev/null
}

# ── open / run (dev) ───────────────────────────────────────────────────────
cmd_open() { [ -n "${1:-}" ] || die "Uso: assistant open <app>"; exec dev "$@"; }
cmd_run()  { [ -n "${1:-}" ] || die "Uso: assistant run <cmd...>"; exec dev "$@"; }

# ── input (X11 real — xdotool) ────────────────────────────────────────────
cmd_type() {
  have_x || die "sin sesión X."
  xneed xdotool || die "falta xdotool."
  xdotool type -- "${1:?Uso: assistant type \"texto\"}" >/dev/null 2>&1 \
    && echo "ok tecleado: ${1}" || { echo "✗ no pude teclear." >&2; return 1; }
}

cmd_key() {
  have_x || die "sin sesión X."
  xneed xdotool || die "falta xdotool."
  [ -n "${1:-}" ] || die "Uso: assistant key ctrl+c|alt+tab|return|tab|super..."
  local combo="$1"
  local mapped
  case "$combo" in
    ctrl+c) mapped="ctrl+c" ;; ctrl+v) mapped="ctrl+v" ;; ctrl+a) mapped="ctrl+a" ;;
    ctrl+s) mapped="ctrl+s" ;; ctrl+w) mapped="ctrl+w" ;;
    alt+tab) mapped="alt+Tab" ;;
    super)   mapped="super_L" ;;
    enter|return) mapped="Return" ;;
    tab)     mapped="Tab" ;;
    space)   mapped="space" ;;
    esc|escape) mapped="Escape" ;;
    *)       mapped="$combo" ;;
  esac
  xdotool key "${mapped}" >/dev/null 2>&1 && echo "ok tecla: $combo ($mapped)" \
    || { echo "✗ no pude enviar $combo" >&2; return 1; }
}

cmd_click() {
  have_x || die "sin sesión X."
  xneed xdotool || die "falta xdotool."
  local x="${1:?Uso: assistant click X Y}" y="${2:?}"
  xdotool mousemove --sync "${x}" "${y}" click 1 >/dev/null 2>&1 \
    && echo "ok click izq ($x,$y)" || return 1
}

cmd_rclick() {
  have_x || die "sin sesión X."; xneed xdotool || die "falta xdotool."
  local x="${1:?}" y="${2:?}"
  xdotool mousemove --sync "${x}" "${y}" click 3 >/dev/null 2>&1 \
    && echo "ok click der ($x,$y)" || return 1
}

cmd_move() {
  have_x || die "sin sesión X."; xneed xdotool || die "falta xdotool."
  local x="${1:?Uso: assistant move X Y}" y="${2:?}"
  xdotool mousemove --sync "${x}" "${y}" >/dev/null 2>&1 && echo "ok move ($x,$y)" || return 1
}

cmd_drag() {
  have_x || die "sin sesión X."; xneed xdotool || die "falta xdotool."
  local x="${1:?Uso: assistant drag X Y}" y="${2:?}"
  xdotool mousedown 1 mousemove_relative -- "${x%.*}" "${y%.*}" mouseup 1 >/dev/null 2>&1 \
    && echo "ok drag" || return 1
}

# ── ventanas (listar / mover ventana de forma fiable) ─────────────────────
cmd_windows() {
  have_x || die "sin sesión X."; xneed xdotool || die "falta xdotool."
  local active="$(xdotool getactivewindow 2>/dev/null)"
  xdotool search --onlyvisible --name ".*" 2>/dev/null | while read -r id; do
    local name geo p
    name="$(xdotool getwindowname "$id" 2>/dev/null)"
    p="$(xdotool getwindowgeometry "$id" 2>/dev/null | grep -i position | awk '{print $2}')"
    geo="$(xdotool getwindowgeometry "$id" 2>/dev/null | grep -i geometry | awk '{print $2}')"
    [ -n "${name}" ] && printf "  %s  %s  %s  x%s\n" "$([ "$id" = "$active" ] && echo '*' || echo ' ')" "$id" "${name}" "${p} ${geo}"
  done
}

cmd_winmove() {
  have_x || die "sin sesión X."; xneed xdotool || die "falta xdotool."
  local x="${1:?Uso: assistant winmove <x> <y> [window_id]}" y="${2:?}"
  local wid="${3:-$(xdotool getactivewindow 2>/dev/null)}"
  [ -n "${wid}" ] || die "no hay ventana activa."
  xdotool windowmove --sync "${wid}" "${x}" "${y}" >/dev/null 2>&1 \
    && echo "ok ventana ${wid} movida a (${x},${y})" || return 1
}

# ── vídeo (ffmpeg x11grab) ────────────────────────────────────────────────
cmd_record() {
  have_x || die "sin sesión X."
  xneed ffmpeg || die "falta ffmpeg."
  local secs="${1:-8}"
  local out="${2:-${SHOT_DIR}/record.webm}"
  mkdir -p "$(dirname "$out")"
  echo "grabando ${secs}s -> ${out} ..."
  ffmpeg -y -loglevel error -f x11grab -video_size "${RESOLUTION:-1920x1080}" \
    -framerate 15 -i "${DISPLAY}" -t "${secs}" -c:v libvpx -b:v 1M "${out}" >/dev/null 2>&1 \
    || { echo "✗ no se pudo grabar (¿ffmpeg?)" >&2; return 1; }
  echo "ok $out ($(du -h "${out}" | cut -f1))"
}

# ── archivos compartidos (/workspace es bind mount con el host) ───────────
cmd_files() {
  local dir="${1:-}"
  local base="/workspace${dir:+/${dir}}"
  [ -d "${base}" ] || die "no existe ${base}"
  echo "contenido de ${base}:"
  ls -lah "${base}" 2>/dev/null | sed -n '1,40p'
}

cmd_here() {
  local src="${1:?Uso: assistant here <path> [nombre]}"
  local name="${2:-$(basename "${src}")}"
  [ -f "${src}" ] || die "no existe ${src}"
  command -v cp >/dev/null 2>&1
  cp "${src}" "${SHOT_DIR}/${name}" && echo "ok ${SHOT_DIR}/${name}  (para el host: scp -P 2222 admin@localhost:/workspace/ai/${name} . )"
}

# ── dispatch ───────────────────────────────────────────────────────────────
case "${1:-help}" in
  status)   cmd_status ;;
  shot)     cmd_shot "${2:-}" ;;
  region)   cmd_region "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
  ocr)      cmd_ocr "${2:-}" ;;
  open)     shift; cmd_open "$@" ;;
  run)      shift; cmd_run "$@" ;;
  wd)       shift; exec wdctl.py "$@" ;;
  type)     cmd_type "${2:-}" ;;
  key)      cmd_key "${2:-}" ;;
  click)    cmd_click "${2:-}" "${3:-}" ;;
  rclick)   cmd_rclick "${2:-}" "${3:-}" ;;
  move)     cmd_move "${2:-}" "${3:-}" ;;
  drag)     cmd_drag "${2:-}" "${3:-}" ;;
  windows)  cmd_windows ;;
  winmove)  cmd_winmove "${2:-}" "${3:-}" "${4:-}" ;;
  record)   cmd_record "${2:-}" "${3:-}" ;;
  files)    cmd_files "${2:-}" ;;
  here)     cmd_here "${2:-}" "${3:-}" ;;
  help|-h|--help) cmd_help ;;
  *) echo "Subcomando desconocido: $1" >&2; cmd_help >&2; exit 1 ;;
esac